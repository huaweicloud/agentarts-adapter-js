{
  "name": "agentarts-harness-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Huawei Cloud AgentArts adapter for hosting DeepSeek Harness agents - monorepo",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "pnpm -r run clean",
    "test": "vitest run && pnpm -r --if-present run test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "format": "prettier --write \"{shared,helper,adapter,precheck,plugins}/**/*.ts\"",
    "demo": "pnpm build && node scripts/demo.mjs",
    "demo:inspect": "pnpm build && node scripts/render-check.mjs",
    "demo:run": "pnpm build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
