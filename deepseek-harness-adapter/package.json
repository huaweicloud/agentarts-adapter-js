{
    "name": "agentarts-harness-dsh",
    "private": true,
    "type": "module",
    "engines": { "node": "^24.22.3 || >=26.13.1" },
    "scripts": {
        "build": "pnpm -r run build && tsc -p tsconfig.tools.json",
        "test": "pnpm build && pnpm -r run test && vitest run",
        "test:coverage": "pnpm -r run build && pnpm -r run test:coverage",
        "smoke": "pnpm run build && node scripts/smoke.mjs",
        "pack:npm": "pnpm build && node scripts/pack-npm.mjs"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.6.0",
        "vitest": "^4.1.11"
    }
}
