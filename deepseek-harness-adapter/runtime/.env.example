# Copy to .env. `node dist/main.js` loads it; process env wins.

# DSH PI CODEX, default DSH
AGENT_RUNTIME_TYPE=

# Runtime HTTP
AGENTARTS_BIND_IP=127.0.0.1
PORT=8080
DSH_ACP_MAX_CONCURRENCY=15
DSH_ACP_LOG_LEVEL=info

# DSH ACP child (defaults mount the token + system-prompt plugins)
DSH_ACP_COMMAND=
DSH_ACP_ARGS=
DSH_ACP_CHILD_ENV={}
DSH_ACP_REQUEST_TIMEOUT_MS=60000
DSH_ACP_VERBOSE=false

# Session defaults
DSH_AGENT_CWD=
DSH_ACP_CWD=
DSH_ACP_MODEL=
DSH_ACP_REASONING_EFFORT=
DSH_ACP_SESSION_TTL_MS=1800000
DSH_ACP_MAX_SESSIONS=50
DSH_ACP_PROMPT_TIMEOUT_MS=600000
DSH_ACP_QUEUE_TIMEOUT_MS=60000
DSH_ACP_TOKEN_STREAM=true

# Approval
DSH_ACP_PERMISSION_MODE=callback
DSH_ACP_APPROVAL_CALLBACK_URL=
DSH_ACP_APPROVAL_HEADERS={}
DSH_ACP_APPROVAL_TIMEOUT_MS=300000
DSH_ACP_PERMISSION_FALLBACK=cancel

# System prompt
DSH_SYSTEM_PROMPT=
DSH_SYSTEM_PROMPT_MODE=append

# AgentArts Gateway MCP
DSH_AGENTARTS_GATEWAY_ENABLED=
DSH_AGENTARTS_GATEWAY_MCP_URL=
DSH_AGENTARTS_GATEWAY_ID=
DSH_AGENTARTS_GATEWAY_TARGET_ID=
DSH_AGENTARTS_GATEWAY_TARGET_NAME=
DSH_AGENTARTS_GATEWAY_SERVER_NAME=agentarts-gateway
DSH_AGENTARTS_GATEWAY_SERVER_TYPE=
DSH_AGENTARTS_GATEWAY_TRANSPORT=auto
DSH_AGENTARTS_GATEWAY_HEADERS={}
DSH_AGENTARTS_GATEWAY_API_KEY=
DSH_AGENTARTS_GATEWAY_API_KEY_HEADER=
DSH_AGENTARTS_GATEWAY_BEARER_TOKEN=
DSH_AGENTARTS_GATEWAY_ACCESS_TOKEN=
DSH_AGENTARTS_GATEWAY_ACCESS_TOKEN_HEADER=
DSH_AGENTARTS_GATEWAY_USER_ID=
DSH_AGENTARTS_GATEWAY_USER_ID_HEADER=
DSH_AGENTARTS_GATEWAY_USE_AUTHORIZER_KEY=true
DSH_AGENTARTS_GATEWAY_CACHE_TTL_MS=300000

# Model / Huawei Cloud control plane
DEEPSEEK_API_KEY=
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_SDK_REGION=cn-southwest-2
HUAWEICLOUD_SDK_PROJECT_ID=
