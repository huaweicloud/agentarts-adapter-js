{
  "name": "@agentarts/adapter",
  "version": "0.0.1",
  "type": "module",
  "description": "Harness adapter: request handlers and schedulers for hosting agents on AgentArts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentarts-dsh-adapter": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@agentarts/shared": "workspace:*",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@huaweicloud/agentarts-sdk": "0.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "clean": "node ../scripts/clean.mjs"
  }
}
