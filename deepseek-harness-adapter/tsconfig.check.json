{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@agentarts/shared": ["./shared/src/index.ts"],
      "@agentarts/helper": ["./helper/src/index.ts"],
      "@agentarts/adapter": ["./adapter/src/index.ts"],
      "@agentarts/precheck": ["./precheck/src/index.ts"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "shared/test/**/*.ts",
    "helper/src/**/*.ts",
    "helper/test/**/*.ts",
    "adapter/src/**/*.ts",
    "adapter/test/**/*.ts",
    "precheck/src/**/*.ts",
    "precheck/test/**/*.ts"
  ]
}
